{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react",
        "@testing-library/**"
      ]
    },
    {
      "groupName": "Vue",
      "matchPackageNames": ["vue", "vue-tsc", "@vue/**", "@vitejs/plugin-vue", "@vueuse/**"]
    },
    {
      "groupName": "Storybook",
      "matchPackageNames": ["storybook", "@storybook/**", "storybook-dark-mode", "chromatic"]
    },
    {
      "groupName": "Vite & Vitest",
      "matchPackageNames": ["vite", "vitest", "vite-plugin-dts"]
    },
    {
      "groupName": "Lint & format",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "eslint-*",
        "prettier",
        "globals",
        "husky",
        "lint-staged"
      ]
    },
    {
      "groupName": "Radix UI",
      "matchPackageNames": ["@radix-ui/**"]
    },
    {
      "description": "Patch updates of dev dependencies merge automatically once CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Runtime and peer dependencies of the published packages: lockfile updates only, so the ranges users must satisfy are never raised by a bot",
      "matchFileNames": ["packages/*/package.json"],
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "rangeStrategy": "in-range-only"
    },
    {
      "description": "Supported Node versions (20, 22, 24) are chosen by hand in ci.yml and engines",
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "Security overrides in pnpm-workspace.yaml for transitive dev dependencies; remove the override instead of bumping it",
      "matchPackageNames": ["uuid", "compression"],
      "enabled": false
    },
    {
      "description": "Removed from react and vue in T-R1B-09 (0.6.0)",
      "matchPackageNames": ["tailwind-merge", "lucide-react", "lucide-vue-next"],
      "enabled": false
    }
  ]
}
