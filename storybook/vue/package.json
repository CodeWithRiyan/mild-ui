{
  "name": "@mild-ui/storybook-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6007",
    "build": "NODE_ENV=production GITHUB_ACTIONS=true storybook build --quiet",
    "build:local": "NODE_ENV=production storybook build --quiet",
    "preview": "pnpm build:local && npx serve storybook-static",
    "test": "test-storybook",
    "chromatic": "chromatic",
    "clean": "rm -rf storybook-static",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mild-ui/core": "workspace:*",
    "@mild-ui/vue": "workspace:*",
    "lucide-vue-next": "^0.284.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-actions": "^8.6.19",
    "@storybook/addon-controls": "^8.6.19",
    "@storybook/addon-docs": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/addon-viewport": "^8.6.19",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.19.1",
    "@storybook/theming": "^8.6.14",
    "@storybook/vue3": "^8.6.19",
    "@storybook/vue3-vite": "^8.6.19",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.6.2",
    "chromatic": "^11.29.0",
    "postcss": "^8.5.32",
    "storybook": "^8.6.19",
    "storybook-dark-mode": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue-tsc": "^2.2.12"
  }
}
