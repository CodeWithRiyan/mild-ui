{
  "name": "@mild-ui/playground-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite playground that renders every mild-ui react component on a single form page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mild-ui/core": "workspace:*",
    "@mild-ui/react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.3",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  }
}
