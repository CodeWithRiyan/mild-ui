{
  "name": "@mild-ui/playground-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite playground that renders every mild-ui vue component on a single form page.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mild-ui/core": "workspace:*",
    "@mild-ui/vue": "workspace:*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^24.1.3",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  }
}
