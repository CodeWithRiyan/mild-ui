{
  "name": "@mild-ui/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "cd packages/core && pnpm build",
    "build:react": "cd packages/react && pnpm build",
    "dev": "pnpm -r dev",
    "test": "pnpm --filter \"./packages/*\" test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "storybook:react": "cd storybook/react && pnpm dev",
    "storybook:build:react": "cd storybook/react && pnpm build",
    "storybook:build:all": "pnpm storybook:build:react",
    "storybook:preview:react": "cd storybook/react && pnpm preview",
    "packages:build": "pnpm --filter @mild-ui/core build && pnpm --filter @mild-ui/react build",
    "validate:workflows": "node scripts/validate-workflows.cjs",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "format:check": "prettier --check .",
    "verify:readme": "tsx scripts/verify-readme.ts",
    "check:packages": "node scripts/check-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^12.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "eslint --fix"
  }
}
