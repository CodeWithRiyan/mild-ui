{
  "name": "@mild-ui/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "cd packages/core && pnpm build",
    "build:react": "cd packages/react && pnpm build",
    "build:vue": "cd packages/vue && pnpm build",
    "dev": "pnpm -r dev",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:coverage": "pnpm --filter \"./packages/*\" test:coverage",
    "test:react:matrix": "node scripts/test-react-matrix.mjs",
    "test:react18": "node scripts/test-react-matrix.mjs 18",
    "test:react19": "node scripts/test-react-matrix.mjs 19",
    "test:vue:matrix": "node scripts/test-vue-matrix.mjs",
    "test:vue:current": "node scripts/test-vue-matrix.mjs current",
    "test:vue:latest": "node scripts/test-vue-matrix.mjs latest",
    "playground:react": "pnpm --filter @mild-ui/playground-react dev",
    "playground:vue": "pnpm --filter @mild-ui/playground-vue dev",
    "lint": "eslint . && pnpm lint:styles",
    "lint:styles": "stylelint \"packages/core/src/sass/components/**/*.scss\" --config packages/core/stylelint.config.mjs",
    "format": "prettier --write .",
    "prepare": "husky",
    "storybook:react": "cd storybook/react && pnpm dev",
    "storybook:vue": "cd storybook/vue && pnpm dev",
    "storybook:build:react": "cd storybook/react && pnpm build",
    "storybook:build:vue": "cd storybook/vue && pnpm build",
    "storybook:build:all": "pnpm storybook:build:react && pnpm storybook:build:vue",
    "storybook:preview:react": "cd storybook/react && pnpm preview",
    "storybook:preview:vue": "cd storybook/vue && pnpm preview",
    "packages:build": "pnpm --filter @mild-ui/core build && pnpm --filter @mild-ui/react build && pnpm --filter @mild-ui/vue build",
    "validate:workflows": "node scripts/validate-workflows.cjs",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --filter \"./storybook/*\" typecheck",
    "format:check": "prettier --check .",
    "verify:readme": "tsx scripts/verify-readme.ts",
    "check:packages": "node scripts/check-packages.mjs",
    "check:storybooks": "node scripts/check-storybook-parity.mjs",
    "size": "node scripts/size-budget.mjs",
    "size:update": "node scripts/size-budget.mjs --update",
    "size:vue": "node scripts/size-budget.mjs --package vue",
    "size:update:vue": "node scripts/size-budget.mjs --package vue --update",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "stylelint": "^16.26.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx,vue}": "eslint --fix",
    "packages/core/src/sass/components/**/*.scss": "stylelint --config packages/core/stylelint.config.mjs"
  }
}
