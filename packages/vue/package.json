{
  "name": "@mild-ui/vue",
  "version": "0.5.1",
  "description": "Vue 3 components for the mild-ui design system",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "mild-ui"
  ],
  "homepage": "https://codewithriyan.github.io/mild-ui/vue/",
  "bugs": {
    "url": "https://github.com/CodeWithRiyan/mild-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithRiyan/mild-ui.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "author": "Muhamad Riyan (https://github.com/CodeWithRiyan)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@vueuse/core": "^13.2.0",
    "clsx": "^2.1.0",
    "lucide-vue-next": "^0.230.0",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
