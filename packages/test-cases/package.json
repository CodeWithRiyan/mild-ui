{
  "name": "@mild-ui/test-cases",
  "version": "0.0.0",
  "private": true,
  "description": "Shared, framework-agnostic per-component test cases for mild-ui. Consumed from source by the framework packages' test suites (react today, vue later).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/cases/*.cases.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  }
}
