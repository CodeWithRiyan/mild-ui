{
  "name": "@mild-ui/react",
  "version": "1.2.0",
  "description": "React components for the mild-ui design system",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "sass",
    "mild-ui"
  ],
  "homepage": "https://codewithriyan.github.io/mild-ui/react/",
  "bugs": {
    "url": "https://github.com/CodeWithRiyan/mild-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithRiyan/mild-ui.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Muhamad Riyan (https://github.com/CodeWithRiyan)",
  "type": "commonjs",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist/",
    "src/styles/",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/mild-ui-react.css",
    "./styles.css": "./dist/mild-ui-react.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && pnpm run build:sass",
    "build:sass": "sass src/styles/index.scss dist/mild-ui-react.css --style=compressed",
    "dev": "npm run build:sass && tsc --watch",
    "sass:watch": "sass src/styles/index.scss dist/mild-ui-react.css --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mild-ui/primitives": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mild-ui/test-cases": "workspace:*",
    "@testing-library/dom": "^10.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
