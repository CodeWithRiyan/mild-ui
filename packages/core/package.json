{
  "name": "@mild-ui/core",
  "version": "0.5.1",
  "description": "SCSS design system for mild-ui: framework-agnostic CSS, themes and design tokens",
  "keywords": [
    "css",
    "scss",
    "sass",
    "design-system",
    "design-tokens",
    "ui",
    "mild-ui"
  ],
  "homepage": "https://codewithriyan.github.io/mild-ui/core/",
  "bugs": {
    "url": "https://github.com/CodeWithRiyan/mild-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithRiyan/mild-ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Muhamad Riyan (https://github.com/CodeWithRiyan)",
  "type": "commonjs",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist/",
    "src/sass/"
  ],
  "exports": {
    "./css": "./dist/mild-ui.css",
    "./mild-ui.css": "./dist/mild-ui.css",
    "./css/min": "./dist/mild-ui.min.css",
    "./css/utilities": "./dist/mild-utilities.css",
    "./css/utilities/min": "./dist/mild-utilities.min.css",
    "./themes/light": "./dist/themes/light.css",
    "./themes/dark": "./dist/themes/dark.css",
    "./tokens": "./dist/tokens.json",
    "./scss": "./src/sass/index.scss",
    "./scss/utilities": "./src/sass/mild-utilities.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:sass",
    "build:sass": "node scripts/build-sass.js",
    "dev": "pnpm run sass:watch",
    "sass:watch": "node scripts/watch-sass.js",
    "clean": "rimraf dist",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:utilities": "node scripts/generate-utility-docs.js",
    "docs:build": "pnpm run docs:generate",
    "docs:serve": "pnpm run docs:generate && serve docs -p 3001",
    "docs:watch": "nodemon --watch src --ext scss --exec \"pnpm docs:generate\"",
    "dev:full": "concurrently \"pnpm run sass:watch\" \"pnpm run docs:serve\""
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.2",
    "cssnano": "^6.1.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "rimraf": "^5.0.10",
    "sass": "^1.106.1",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
