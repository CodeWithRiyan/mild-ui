{
  "font": {
    "family": {
      "$description": "Source: $mild-font-families.",
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "Noto Sans",
          "sans-serif",
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "Noto Color Emoji"
        ]
      },
      "serif": { "$value": ["Georgia", "Cambria", "Times New Roman", "Times", "serif"] },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SF Mono",
          "Monaco",
          "Inconsolata",
          "Roboto Mono",
          "source-code-pro",
          "Menlo",
          "Consolas",
          "DejaVu Sans Mono",
          "monospace"
        ]
      }
    },
    "size": {
      "$description": "Source: $mild-font-sizes.",
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" },
      "5xl": { "$value": "3rem" },
      "6xl": { "$value": "3.75rem" },
      "7xl": { "$value": "4.5rem" },
      "8xl": { "$value": "6rem" },
      "9xl": { "$value": "8rem" }
    },
    "weight": {
      "$description": "Source: $mild-font-weights.",
      "$type": "fontWeight",
      "thin": { "$value": 100 },
      "extralight": { "$value": 200 },
      "light": { "$value": 300 },
      "normal": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    }
  },
  "line-height": {
    "$description": "Source: $mild-line-heights.",
    "$type": "number",
    "none": { "$value": 1 },
    "tight": { "$value": 1.25 },
    "snug": { "$value": 1.375 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.625 },
    "loose": { "$value": 2 }
  },
  "letter-spacing": {
    "$description": "Source: $mild-letter-spacing.",
    "$type": "dimension",
    "tighter": { "$value": "-0.05em" },
    "tight": { "$value": "-0.025em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.025em" },
    "wider": { "$value": "0.05em" },
    "widest": { "$value": "0.1em" }
  }
}
