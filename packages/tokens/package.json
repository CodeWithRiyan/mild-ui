{
  "name": "@mild-ui/tokens",
  "version": "1.2.0",
  "description": "Design tokens for mild-ui as JSON: primitives, semantics and component tokens",
  "keywords": [
    "design-tokens",
    "tokens",
    "json",
    "design-system",
    "mild-ui"
  ],
  "homepage": "https://github.com/CodeWithRiyan/mild-ui/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/CodeWithRiyan/mild-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithRiyan/mild-ui.git",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "author": "Muhamad Riyan (https://github.com/CodeWithRiyan)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.json",
    "dist/"
  ],
  "exports": {
    "./primitives/*": "./src/primitives/*.json",
    "./semantics/*": "./src/semantics/*.json",
    "./css": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css",
    "./scss": "./dist/_tokens.scss",
    "./json": "./dist/tokens.json",
    "./tokens.json": "./dist/tokens.json",
    "./ts": {
      "types": "./dist/tokens.ts",
      "default": "./dist/tokens.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs",
    "clean": "rimraf dist",
    "test": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "style-dictionary": "^4.4.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
